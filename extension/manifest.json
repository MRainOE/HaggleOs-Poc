{
  "manifest_version": 3,
  "name": "HaggleOS Deal Analyzer",
  "version": "1.0.0",
  "description": "Helps analyze eBay deals using our AI backend.",
  "permissions": ["activeTab", "storage", "tabs"],
  "action": {
    "default_title": "HaggleOS Dashboard"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/dashboard*",
        "http://127.0.0.1:3000/dashboard*",
        "https://haggle-os-poc.vercel.app/dashboard*"
      ],
      "js": ["dashboard_bridge.js"],
      "run_at": "document_start"
    }
  ]
}
